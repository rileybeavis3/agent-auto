# Verodex Environment Configuration

# Database
DATABASE_URL=postgresql://verodex:verodex_dev_password@localhost:5432/verodex

# Redis
REDIS_URL=redis://localhost:6379

# Services
IDENTITY_SERVICE_URL=http://localhost:4102
GOVERNANCE_SERVICE_URL=http://localhost:4103
AUDIT_SERVICE_URL=http://localhost:4106

# Cryptography
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here
AUDIT_SIGNING_KEY=your-signing-key-here

# Service Ports
IDENTITY_PORT=4102
GOVERNANCE_PORT=4103
AUDIT_PORT=4106

# Environment
NODE_ENV=development
LOG_LEVEL=debug
